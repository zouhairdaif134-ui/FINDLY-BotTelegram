{
  "name": "findly-v3-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./miniapp",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/telegram/*", "/share/*", "/health"]
  },
  "vars": {
    "SUPABASE_URL": "https://rcebarvpmpxsosclexyg.supabase.co",
    "FINDLY_MINIAPP_URL": "https://findly-v3-api.berrchidcity99.workers.dev/"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://gqowfavdkpqmyxwrpiep.supabase.co",
      "SUPABASE_SECRET_KEY": "sb_publishable_IZuUPJVFlMHY0hWzNP8esw_fj697Ptn"
    }
  },
  "keep_vars": true
}
